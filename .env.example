# ─── Kit — Newsletter ─────────────────────────────────────────────────────────
# 1. kit.com par free account banao (support@pdfmaspro.com se)
# 2. Forms > Create Form > Inline Form > Save
# 3. Form URL se ID lo: kit.com/forms/1234567 → ID = 1234567
# 4. Settings > Developer > API Key (server-side only)
# Cloudflare Dashboard > Workers & Pages > project > Settings > Environment Variables
KIT_API_KEY=your_kit_public_api_key
KIT_FORM_ID=1234567

# ─── Resend — Contact Form ────────────────────────────────────────────────────
# 1. resend.com par free account banao (support@pdfmaspro.com se)
# 2. pdfmaspro.com domain verify karo (DNS mein ek TXT record add karna hoga)
# 3. API Keys > Create API Key > copy karo
# ⚠️  RESEND_API_KEY (bina VITE_) — sirf server-side use hoga, frontend expose nahi hoga
# Cloudflare Dashboard > Workers & Pages > project > Settings > Environment Variables
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# ─── Razorpay — Donations ────────────────────────────────────────────────────
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx

# ─── UPI — Donations ─────────────────────────────────────────────────────────
VITE_UPI_ID=yourname@upi

# ─── PayPal — Donations ──────────────────────────────────────────────────────
VITE_PAYPAL_USERNAME=yourname

# ─── Google AdSense (leave EMPTY until AdSense approves your site) ──────────
# Publisher ID looks like ca-pub-1234567890123456 (digits only after "ca-pub-")
VITE_ADSENSE_CLIENT_ID=
# Numeric ad-unit IDs from AdSense > Ads > By ad unit
VITE_ADSENSE_SLOT_MID=
VITE_ADSENSE_SLOT_SIDEBAR=
VITE_ADSENSE_SLOT_BOTTOM=
